{
  "name": "for-the-kids-backend",
  "version": "0.1.0",
  "description": "Backend del sistema de gestión de campaña de donación de cabello For The Kids (Equipo Tlaxcala)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "resetear-bd": "node src/scripts/resetear_bd.js",
    "test": "jest",
    "test:cobertura": "jest --coverage"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.0.12",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.4",
    "supertest": "^7.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "src/controllers/auth.controller.js",
      "src/middleware/auth.middleware.js",
      "src/middleware/role.middleware.js",
      "src/middleware/asyncHandler.js",
      "src/routes/auth.routes.js",
      "src/utils/validaciones.js",
      "src/utils/jwt.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80
      }
    }
  }
}
