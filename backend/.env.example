# Copiar este archivo como .env y llenar con los valores reales
# (nunca subir el .env real al repositorio)

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=for_the_kids
DB_USER=postgres
DB_PASSWORD=

# Autenticación (RF-02)
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_EXPIRES_IN=24h

# Correo (RF-08, RF-09)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# Entorno
PORT=4000
NODE_ENV=development
